# Default TOML configuration for Robot Autonomy
# Autogenerated C++ getters and struct definitions will be created from this file.

[camera]
device_id = 0
image_width = 1920
image_height = 1080
fps = 30.0
frame_id = "camera_color_optical_frame"

[perception]
model_path = "models/presence_detector.onnx"
confidence_threshold = 0.75
nms_threshold = 0.3
enable_cuda = true

[control]
loop_rate_hz = 50
max_linear_velocity = 1.5
max_angular_velocity = 2.0
