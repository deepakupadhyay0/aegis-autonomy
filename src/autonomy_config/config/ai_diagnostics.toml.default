# Advisory-only AI diagnostics; disabled by default.

enabled = false
# "dds" consumes diagnostic_msgs/DiagnosticArray. "log_files" reads the
# existing rotating per-node files without publishing a duplicate DDS stream.
input_mode = "dds"
input_topic = "/diagnostics"
report_topic = "/ai_diagnostics/report"
queue_capacity = 64
minimum_log_level = "info"
# Each incident window is bounded by record count and parsed evidence bytes.
# A health=ok INFO log record or DDS DiagnosticStatus::OK closes an incident.
max_records_per_batch = 256
# Conservative starting budget for a small local model; profile with the
# complete autonomy workload before increasing it.
maximum_context_bytes = 8192
cursor_filename = ".ai_diagnostics.cursor"

cpu_threshold_percent = 35.0
idle_samples_required = 5
sample_interval_ms = 1000
analysis_cooldown_ms = 30000

request_timeout_ms = 30000
maximum_response_bytes = 65536
# The local server is a separate process and must be started explicitly.
endpoint = "http://127.0.0.1:8080/v1/chat/completions"
model = "aegis-diagnostics"
api_key_env = ""
