# Runtime wiring and model dimensions for the place-recognition node.

[ros]
image_topic = "/camera/color/image_raw/compressed"
wifi_topic = "/localization/wifi_observation"
descriptor_topic = "/localization/place_descriptor"
image_queue_depth = 1
wifi_queue_depth = 1

[model]
checkpoint_path = ""
wifi_feature_count = 5
access_point_count = 5
hidden_size = 128
descriptor_size = 64
image_width = 160
image_height = 120
maximum_wifi_age_ms = 500
